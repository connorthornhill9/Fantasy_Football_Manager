# Copy to .env and fill in. Lines starting with # are comments.

# ---- Sleeper -------------------------------------------------------------
# Your Sleeper username (the one shown on your profile).
SLEEPER_USERNAME=

# League id from the Sleeper URL (sleeper.com/leagues/<id>/...). Optional if you are
# in exactly one league this season; `python -m ffm whoami` lists your leagues.
SLEEPER_LEAGUE_ID=

# Your Sleeper session token. Needed only to EXECUTE approved moves; leave blank for dry runs.
# Treat it like a password: it gives full control of your Sleeper account.
SLEEPER_TOKEN=

# ---- Discord -------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Channel where proposals are posted (Developer Mode -> right-click channel -> Copy ID)
DISCORD_CHANNEL_ID=
# Your Discord user id; only this user can approve/reject moves
DISCORD_OWNER_ID=
# Optional: server id. Makes slash commands appear immediately in that server.
DISCORD_GUILD_ID=

# ---- Claude --------------------------------------------------------------
ANTHROPIC_API_KEY=
FFM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
FFM_EFFORT=high

# ---- Behaviour -----------------------------------------------------------
# Scheduled runs, as cron expressions (minute hour day-of-month month day-of-week; 0 = Sunday,
# or names like "tue"). Set one to "off" to disable it. Defaults suit a league whose waivers
# process Wednesday noon with free-agent pickups allowed on the other days.
FFM_CRON_FA_SWEEP=0 8 * * 1
FFM_CRON_MARKET=0 9 * * 2
FFM_CRON_POST_WAIVERS=30 3 * * 4
FFM_CRON_LATE_WEEK=0 18 * * 6
# Free text about your league's pickup rules that the API cannot express; it goes into the
# advisor's briefing verbatim. Example:
# FFM_LEAGUE_NOTES=Mon: free agents. Tue: locked, no pickups. Wed: waiver day all day; claims process at noon EDT and again at the 3 AM EDT day boundary. Thu-Sun: free agents from about 3 AM Thursday. No game-time lock: a player can be added right after he plays.
FFM_LEAGUE_NOTES=
# Tone for /introduce and /roast: pg13 (default) or r (swearing and crude jokes allowed; never slurs or personal attacks)
FFM_ROAST_RATING=pg13
# IANA timezone for the schedule, e.g. America/Toronto. Blank = this computer's local time.
FFM_TIMEZONE=
# true = approved moves are logged but never sent to Sleeper (good for a first week)
FFM_DRY_RUN=false
# Maximum proposals per analysis run
FFM_MAX_PROPOSALS=6
# Let the model search a short allowlist of sports sites for late news (a few searches per run)
FFM_WEB_SEARCH=true
# Pull ESPN's public injury report and headlines into the briefing
FFM_ESPN_NEWS=true
